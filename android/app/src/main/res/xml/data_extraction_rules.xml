<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : la checklist et les réglages suivent la sauvegarde / le transfert d'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
